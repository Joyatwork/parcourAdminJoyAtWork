APP_NAME="JoyAtWork Admin API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api-admin.example.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=railway
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# Origines autorisees, separees par des virgules (sans slash final)
CORS_ALLOWED_ORIGINS=https://admin.example.com

# Optionnel : uniquement pour la commande db:seed
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrateur
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=JoyAtWork
